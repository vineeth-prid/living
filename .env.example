# Copy to .env.local and fill in. Never commit .env.local.

# Postgres (your server). sslmode=require if it's reachable over the network.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/living

# MinIO — public base URL of the bucket, no trailing slash.
# Path-style:    https://minio.yourhost.com/living-images
# Virtual-host:  https://living-images.minio.yourhost.com
# Leave unset locally to serve images from /public instead.
NEXT_PUBLIC_IMAGE_CDN=https://minio.yourhost.com/living-images

# MinIO write credentials — needed only by the admin panel's media uploads.
# The public site reads through NEXT_PUBLIC_IMAGE_CDN above and needs none of these.
MINIO_ENDPOINT=minio.yourhost.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=living-images
