# Copy to .env.local and fill in. Never commit .env.local.

# Postgres (your server). sslmode=require if it's reachable over the network.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/living

# MinIO — public base URL of the bucket, no trailing slash.
# Path-style:    https://minio.yourhost.com/living-images
# Virtual-host:  https://living-images.minio.yourhost.com
# Leave unset locally to serve images from /public instead.
NEXT_PUBLIC_IMAGE_CDN=https://minio.yourhost.com/living-images

# MinIO credentials. Needed for uploads AND for reading them back: uploaded
# photos and receipts are served by /media/… using these, so the bucket can
# stay private and NEXT_PUBLIC_IMAGE_CDN is only for the static site imagery.
MINIO_ENDPOINT=minio.yourhost.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=living-images

# SMTP — event-driven notification email (new enquiry, lead assigned).
# Leave SMTP_HOST unset to disable: attempts are logged as "skipped" rather
# than lost, and nothing else in the app changes.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (implicit TLS)
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Living <notifications@livingbyitr.com>"
# Who gets "new website enquiry" alerts. Comma-separated. Defaults to the
# public inbox in lib/site.ts when unset.
NOTIFY_TEAM_EMAILS=sales@livingbyitr.com

# --- WhatsApp (OpenWA) ----------------------------------------------------
# Self-hosted OpenWA gateway. Leave OPENWA_ENABLED unset to run without it —
# the CRM is fully functional with the whole integration switched off.
# Never prefix any of these with NEXT_PUBLIC_: the key and the secret must not
# reach the browser.
OPENWA_ENABLED=false
OPENWA_BASE_URL=https://openwa.internal.example
OPENWA_API_KEY=owa_k1_replace_me
# The session UUID of the WhatsApp connection, created and paired on the VPS.
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_URL=https://livingbyitr.com/api/integrations/openwa/webhook
# 32+ random characters: openssl rand -hex 32
OPENWA_WEBHOOK_SECRET=
# Budget for status checks and text sends. Short on purpose: a dead gateway
# should be noticed quickly.
OPENWA_TIMEOUT_MS=10000
# Budget for a media send — the one call that moves megabytes. Separate, because
# raising the one above for both means a broken gateway takes a minute to report.
OPENWA_MEDIA_TIMEOUT_MS=60000
OPENWA_MAX_RETRIES=3

# Outbound throttle. Unofficial gateways get numbers banned for looking like
# bulk senders; these are deliberately low.
WHATSAPP_MAX_PER_MINUTE=20
WHATSAPP_MIN_GAP_MS=1200

# Confidence bands for AI-parsed commands. Above `execute` runs; between the
# two asks for confirmation; below `confirm` is refused.
WHATSAPP_CONFIDENCE_EXECUTE=0.9
WHATSAPP_CONFIDENCE_CONFIRM=0.7
# How long a pending confirmation stays answerable.
WHATSAPP_PENDING_TTL_MS=900000
# Applied only to numbers with no country code of their own.
PHONE_DEFAULT_COUNTRY_CODE=91

# Every relative date ("tomorrow at 10") resolves against this.
CRM_TIMEZONE=Asia/Kolkata

# --- Broadcasts -----------------------------------------------------------
# The ceiling on one bulk send. Not a performance limit — at 20 a minute a list
# this long is already over two hours — but a guard so a mis-set filter cannot
# reach the whole database before anyone has read the preview.
WHATSAPP_MAX_AUDIENCE=2000
# How many recipients one drain pass attempts. The queue drains from the admin
# page and from every inbound webhook, so this is a batch size, not a rate.
WHATSAPP_BROADCAST_BATCH=15

# How many times one recipient is attempted before the sender gives up on them.
# The automatic loop had no ceiling at all once, and a row reached 28 attempts.
WHATSAPP_BROADCAST_MAX_ATTEMPTS=3

# How the attachment reaches the gateway: "url" (default) or "base64".
#
# With "url" the gateway fetches it from APP_BASE_URL over HTTPS. That fetch
# happens AFTER the send API has already answered 201, so when it fails — a
# container missing ca-certificates has done this twice — the API reports
# success, the message is recorded locally, and the phone never shows it. There
# is no error to find.
#
# Set "base64" to send the bytes inline and remove that step entirely. Use it to
# tell "the gateway cannot reach us" from "the gateway cannot upload", and as a
# fallback while the container trust store is unreliable.
WHATSAPP_MEDIA_TRANSPORT=url
# Above this, the URL is used regardless — base64 inflates by a third and goes
# over the wire once per recipient.
WHATSAPP_MAX_INLINE_BYTES=8388608

# --- The broadcast scheduler ----------------------------------------------
# Shared secret for /api/cron/whatsapp, which is what releases scheduled
# broadcasts on a timer. 32+ random characters: openssl rand -hex 32
#
# No secret means the endpoint refuses everything. An unauthenticated trigger
# for sending hundreds of WhatsApp messages is not something to leave open, and
# "I forgot to set it" has to fail closed.
#
# The cron itself, on the VPS:
#   */5 * * * * curl -fsS -m 120 -H "X-Cron-Key: $CRON_SECRET" \
#     https://livingbyitr.com/api/cron/whatsapp >/dev/null
CRON_SECRET=

# How late a scheduled broadcast may still go out. Past this it is parked for a
# human rather than sent: an offer arriving long after its deadline is worse
# than one that did not arrive. Long enough to survive an ordinary reboot.
WHATSAPP_SCHEDULE_GRACE_MINUTES=180

# When the panel starts calling the scheduler broken. Deliberately several times
# the cron interval — an alarm that cries wolf is one people learn to ignore.
WHATSAPP_HEARTBEAT_STALE_MINUTES=30

# --- Customer auto-replies ------------------------------------------------
# Lets the local model answer a customer's question from Living's own published
# listings. Off unless this is exactly "true": a model answering customers
# unsupervised is a business decision, and an unset variable has to mean the
# old behaviour (acknowledge once, let a human reply).
#
# It can only ever repeat facts from published listings and the office details —
# never an internal figure, never a promise, never a price that is not already
# on the website. Anything it cannot answer from those is handed to a human.
WHATSAPP_AI_REPLIES=false
# Outbound messages allowed into one conversation per hour. A loop then costs a
# handful of messages instead of a banned number.
WHATSAPP_AI_REPLY_BUDGET=6
# A little warmth for prose, unlike the 0 used for parsing intents.
OLLAMA_REPLY_TEMPERATURE=0.3

# --- Ollama ---------------------------------------------------------------
# Reads WhatsApp messages and returns a structured intent. It never touches the
# database and never generates SQL. Unset means WhatsApp commands are refused
# with "the assistant is unavailable" rather than guessed at.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=30000
OLLAMA_TEMPERATURE=0

# Homepage hero film. Leave unset and the site serves the licensed placeholder
# in public/videos/hero-living.mp4 (see the SOURCE.txt beside it). Set this to
# the Living footage in the bucket once it exists — same idea as
# NEXT_PUBLIC_IMAGE_CDN, and it moves a megabyte per homepage visit off the app
# server. Either way the still photograph stays the poster and the fallback, so
# a 404 or a blocked autoplay costs nothing.
NEXT_PUBLIC_HERO_VIDEO_URL=

# This deployment's own origin, no trailing slash. Staff links sent over
# WhatsApp (a draft to review, a preview before publishing) point here, so a
# draft created in staging is reviewed in staging. Leave unset in production,
# where it falls back to the canonical site URL. Not NEXT_PUBLIC_: these links
# are built on the server and a staging hostname is not for the public bundle.
APP_BASE_URL=https://staging.livingbyitr.com

# Rows in one property CSV export. Generous — this is a property business, not a
# marketplace — but present, so an export cannot be the thing that holds a
# connection open building one enormous string.
PROPERTY_EXPORT_MAX=5000
